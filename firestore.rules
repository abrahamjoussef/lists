rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function ownerDoc(owner) {
      return get(/databases/$(database)/documents/users/$(owner)).data;
    }
    // access is given list by list: users/{owner}.access[memberUid][listId] = 'edit' | 'view'
    // ('main' is the main list)
    // the signed-in person's email, lower case ('' if none)
    function myEmail() {
      return request.auth.token.get('email', '').lower();
    }
    // invites to people with no account yet: users/{owner}.invites[email].lists[listId] = 'edit' | 'view'
    // (the owner's app turns an invite into an access entry once that person has registered)
    function roleOn(owner, lid) {
      let d = ownerDoc(owner);
      let r = d.get('access', {}).get(request.auth.uid, {}).get(lid, '');
      return r != '' ? r : (myEmail() == '' ? '' : d.get('invites', {}).get(myEmail(), {}).get('lists', {}).get(lid, ''));
    }
    function canRead(owner, lid) {
      return request.auth.uid == owner || roleOn(owner, lid) in ['edit', 'view'];
    }
    function canWrite(owner, lid) {
      return request.auth.uid == owner || roleOn(owner, lid) == 'edit';
    }
    // email -> account lookup (only exact-email reads, no browsing)
    match /emails/{email} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }
    // who invited this email before it had an account: written by the inviter, read (and cleared) by the invitee
    match /invites/{email}/from/{fromUid} {
      allow read: if signedIn() && (request.auth.uid == fromUid || myEmail() == email);
      allow create, update: if signedIn() && request.auth.uid == fromUid && email != myEmail();
      allow delete: if signedIn() && (request.auth.uid == fromUid || myEmail() == email);
    }
    // each person's profile + who they share their list with (and how)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /sharedWithMe/{fromUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update, delete: if signedIn() && (request.auth.uid == fromUid || request.auth.uid == uid);
      }
    }
    // a list's name/icon/type: only its owner changes it; people it is shared with can read it
    match /ulists/{owner}/lists/{lid} {
      allow read: if signedIn() && canRead(owner, lid);
      allow write: if signedIn() && request.auth.uid == owner;
    }
    // items, history and suggestions of an extra list
    match /ulists/{owner}/lists/{lid}/{rest=**} {
      allow read: if signedIn() && canRead(owner, lid);
      allow write: if signedIn() && canWrite(owner, lid);
    }
    // items, history and suggestions of the main list
    match /ulists/{owner}/{coll}/{rest=**} {
      allow read: if signedIn() && coll != 'lists' && canRead(owner, 'main');
      allow write: if signedIn() && coll != 'lists' && canWrite(owner, 'main');
    }
  }
}
